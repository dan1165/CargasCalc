  "narrative": {
    "northStar": "Midnight Transit",
    "overview": "CargasCalc is a route map for one shared pot. The cash in hand is the junction; each person is a coloured line leaving it; the amount still owed to them is the bright tail of that line, and what they already took is the dim track behind it. The world comes from the KL rail diagram read at night — enamel navy, porcelain lettering, and three inks that stay identifiable at a glance — while the controls underneath are ordinary iPhone controls.\n\nThe screen is one continuous map sheet, not a stack of cards. Type does the hierarchy: a light, large cash figure at the top, a poster-scale payout at each station, and small tracked captions for the arithmetic. Colour is reserved for the three lines and never carries meaning alone; every coloured state is also written in words.",
    "keyCharacteristics": [
      "Deep midnight ground with a single vertical light fall.",
      "Three fixed line inks: scarlet Imran, amber Bambang, cobalt Danii.",
      "Porcelain text; secondary and tertiary tints are blue-grey, never neutral grey.",
      "One horizontal route bar and three station rails; no decorative side stripes.",
      "Native iOS navigation, lists, sheets, text fields, and decimal pads."
    ],
    "rules": [
      { "name": "The Line-Ink Rule", "body": "Only the three routes carry hue. Text, chrome, and backgrounds stay in the blue-grey family; a fourth accent never appears.", "section": "colors" },
      { "name": "The Written-State Rule", "body": "A negative payout is not signalled by red alone: the row says 'owes' and 'over the share' beside the figure.", "section": "colors" },
      { "name": "The Money-Is-The-Display Rule", "body": "The largest object on the screen is always an amount, never a title, icon, or decorative graphic.", "section": "typography" },
      { "name": "The No-Glass Rule", "body": "No custom blur, frosted card, or translucent overlay. If a surface needs separation, change its tone or add a hairline.", "section": "elevation" }
    ],
    "dos": [
      "Do keep the four inputs and three payouts on one screen at the default text size.",
      "Do pair every colour-coded fact with words or position.",
      "Do use monospaced digits for every amount.",
      "Do let the rail run continuously between stations.",
      "Do keep the primary button the only porcelain-filled element."
    ],
    "donts": [
      "Don't add a fourth accent colour; the three lines are the whole palette.",
      "Don't turn station rows into cards or add a coloured bar down one edge.",
      "Don't use gradient text, glass, or celebratory motion.",
      "Don't add mascots, badges, streaks, or ranking.",
      "Don't move the cash field behind a tab, sheet, or onboarding step."
    ]
  }
